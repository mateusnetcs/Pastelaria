# === Produção: https://pastelaobhoters.chatboot.cloud ===
# Copie estas variáveis no Coolify (Environment Variables)

# Google Sign-In (obrigatório para login com Google)
# No Google Cloud Console: ative também a "People API" para sincronizar aniversário dos clientes.
GOOGLE_CLIENT_ID=462235507761-eo9faptcf13av0v5f95irn6fmhsli8jr.apps.googleusercontent.com

# CORS — domínio do site em produção
ALLOWED_ORIGINS=https://pastelaobhoters.chatboot.cloud

# URL pública do backend (webhooks Mercado Pago, links, etc.)
# Obrigatório para confirmar PIX automaticamente: Mercado Pago chama {WEBHOOK_PUBLIC_URL}/api/mercadopago/webhook
WEBHOOK_PUBLIC_URL=https://pastelaobhoters.chatboot.cloud

# Banco, OpenAI, Mercado Pago, WAHA — use os valores reais de produção
# DB_HOST=
# DB_NAME=pastelaria
# DB_USER=
# DB_PASSWORD=
# OPENAI_API_KEY=
# MERCADOPAGO_ACCESS_TOKEN=
# WAHA_API_URL=
# WAHA_API_KEY=
# FLASK_SECRET_KEY=
